          "port": "8000",
          "path": ["predict"]
        },
        "description": "Predict performance for an average student"
      }
    },
    {
      "name": "Predict - Invalid Data (Should Fail)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gender\": \"Male\",\n  \"caste\": \"General\",\n  \"mathematics_marks\": 150,\n  \"english_marks\": -10,\n  \"science_marks\": 82,\n  \"father_occupation\": \"Invalid Job\",\n  \"mother_occupation\": \"Teacher\",\n  \"number_of_siblings\": 2,\n  \"boarding\": \"No\",\n  \"distance_from_home\": \"Near\",\n  \"time\": 5,\n  \"coaching\": \"Yes\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/predict",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["predict"]
        },
        "description": "Test validation with invalid marks (out of range). Should return 422 error."
      }
    }
  ]
}
